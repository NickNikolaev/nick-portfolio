---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Work from '../components/Work.astro';
import Impact from '../components/Impact.astro';
import AiWorkflow from '../components/AiWorkflow.astro';
import Faq from '../components/Faq.astro';
import SocialProof from "../components/SocialProof.astro";
---

<Base>
  <Hero />

  <SocialProof />

  <Experience />

  <Work />

  <Impact />

  <AiWorkflow />

  <Faq />

  <section class="py-24 md:py-32">
    <div class="max-w-2xl mx-auto px-6">
      <div class="bg-brand rounded-lg p-10 md:p-12 text-center text-white">
        <p class="text-xs uppercase tracking-[0.2em] mb-6">
          Mission
        </p>
        <p class="text-2xl md:text-3xl leading-snug">
          Hilf Schweizer Early-Stage-Startups dabei, meine Eignung als Tech-Leiter einzuschätzen, durch den Aufbau eines Portfolios, das künftig den Weg eines Startups von Pre-PMF bis Post-PMF dokumentieren wird.
        </p>
      </div>
    </div>
  </section>
</Base>
