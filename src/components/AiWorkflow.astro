---
type DemoType = 'typewriter' | 'split' | 'tests' | 'terminal' | 'checks' | 'git';

interface Step {
  title: string;
  description: string;
  why: string;
  demo: DemoType;
  optional?: boolean;
}

const tools = [
  { name: 'Claude Code', logo: '/assets/logos/claude.svg' },
  { name: 'Cursor',      logo: '/assets/logos/cursor.png' },
];

const steps: Step[] = [
  {
    title: 'Spec zuerst',
    demo: 'typewriter',
    description:
      'Cursor generiert die Spec-Datei 01-feature.md mit User Stories (Given/When/Then), Acceptance Criteria, Tech Stack und Constraints.',
    why: 'Eine KI ohne klare Spec löst das falsche Problem.',
  },
  {
    title: 'Design Handoff + Iteration',
    demo: 'split',
    optional: true,
    description:
      'Claude Design generiert eine Visualisierung basierend auf requirements.md. Nach abgeschlossener Iteration wird der Handoff-Ordner exportiert.',
    why: 'Eine einzige Quelldatei verhindert, dass Spec und Design auseinanderlaufen.',
  },
  {
    title: 'Tests vor Code',
    demo: 'tests',
    description:
      'Claude Code generiert eine komplette Test-Suite (Unit / Component / E2E) inklusive Edge Cases. Alle Tests schlagen fehl — das ist korrekt.',
    why: 'Tests definieren «done». Ohne Tests passt die KI den Code an — nicht das Problem.',
  },
  {
    title: 'Code-Generierung',
    demo: 'terminal',
    description:
      'Claude Code (Agent Mode) implementiert die Lösung gegen die bestehende Test-Suite. Der Prompt enthält: «Ändere die Tests nicht, um sie zu bestehen.»',
    why: 'Dieser eine Satz verhindert, dass die KI sich selbst betrügt.',
  },
  {
    title: 'Abnahme via Slash Command',
    demo: 'checks',
    description:
      'Claude Code führt /verify docs/specs/YYYY/MM/01-feature.md aus — prüft, ob alle User Stories abgedeckt und die CONSTITUTION.md-Regeln eingehalten sind.',
    why: 'Grüne Tests ≠ vollständige Lösung.',
  },
  {
    title: 'Commit & GitHub Push',
    demo: 'git',
    description:
      'Commit im Conventional-Commits-Format, Push zu GitHub, CI/CD läuft automatisch durch.',
    why: 'Nachvollziehbarkeit ist Professionalität.',
  },
];

const lastIndex = steps.length - 1;
const promptText =
  '"Build me the AI-Workflow timeline section based on docs/specs/2026/06/ai-section/requirements.md — include all 6 steps, animations, and tool badges."';
const checkItems = [
  'Visitor sees 6 steps',
  'Step 2 displays an "Optional" badge',
  'Connector renders correctly',
  'CONSTITUTION.md has been followed',
];
---

<section id="ai-workflow" class="mx-auto max-w-3xl px-6 py-20 scroll-mt-16">
  <!-- Header -->
  <div class="flex flex-col gap-3">
    <span class="font-mono text-xs uppercase tracking-[0.18em] text-slate-400">05 — KI-Workflow</span>
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">Wie ich KI in der Entwicklung einsetze</h2>
    <p class="max-w-2xl text-[15px] leading-relaxed text-slate-500">
      Strukturierter Prozess — von der Spec bis zum Commit — mit Claude Code und Cursor.
    </p>
    <!-- Tool-Badges -->
    <div class="mt-1 flex flex-wrap items-center gap-x-5 gap-y-2">
      {tools.map((t) => (
        <span class="inline-flex items-center gap-2 text-sm font-medium text-slate-600">
          <img src={t.logo} alt="" width="16" height="16" class="h-4 w-4 object-contain" />
          {t.name}
        </span>
      ))}
    </div>
  </div>

  <!-- Timeline -->
  <ol class="mt-14 flex flex-col" role="list">
    {steps.map((step, i) => (
      <li class="ai-step flex flex-col gap-3 md:grid md:grid-cols-[auto_1fr] md:gap-x-5" data-demo={step.demo}>
        <!-- Rail -->
        <div class="flex flex-row items-center gap-3 md:flex-col md:gap-0">
          <span class="z-10 inline-flex items-center rounded-full bg-brand/10 px-2.5 py-1 font-mono text-xs font-bold tabular-nums text-brand">
            {String(i + 1).padStart(2, '0')}
          </span>
          {i < lastIndex && (
            <span class="mt-2 hidden w-0 grow border-l-2 border-slate-200 md:block" aria-hidden="true"></span>
          )}
        </div>

        <!-- Content -->
        <div class={i < lastIndex ? 'pb-12' : ''}>
          <div class="flex flex-wrap items-center gap-2.5">
            <h3 class="text-base font-semibold text-slate-900">{step.title}</h3>
            {step.optional && (
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-slate-500">
                Optional
              </span>
            )}
          </div>
          <p class="mt-2 text-[15px] leading-relaxed text-slate-600">{step.description}</p>
          <p class="mt-3 border-l-2 border-brand/30 pl-3 text-sm italic text-slate-500">
            <span class="font-medium not-italic text-slate-600">Warum:</span> {step.why}
          </p>

          <!-- Animations-Panel (dekorativ) -->
          <div class="mt-4" aria-hidden="true">
            {step.demo === 'typewriter' && (
              <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="flex items-center gap-1.5 border-b border-slate-100 bg-slate-50 px-3 py-2">
                  <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-slate-300"></span>
                  <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-slate-300"></span>
                  <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-slate-300"></span>
                  <span class="ml-2 whitespace-nowrap font-mono text-[11px] text-slate-400">01-feature.md</span>
                </div>
                <pre class="m-0 min-h-[112px] whitespace-pre-wrap px-4 py-3 font-mono text-[12px] leading-relaxed text-slate-600"><span class="ai-type"></span><span class="ai-caret"></span></pre>
              </div>
            )}

            {step.demo === 'split' && (
              <div class="grid grid-cols-2 gap-3">
                <div class="ai-prompt rounded-xl border border-dashed border-slate-300 bg-white p-3">
                  <div class="font-mono text-[10px] uppercase tracking-wide text-slate-400">Raw Prompt</div>
                  <p class="mt-2 text-[11px] leading-snug text-slate-400">{promptText}</p>
                </div>
                <div class="ai-card rounded-xl border border-brand/20 bg-white p-3 shadow-sm ring-1 ring-brand/5">
                  <div class="flex items-center gap-1.5">
                    <img src="/assets/logos/claude.svg" alt="" class="h-3.5 w-3.5" />
                    <span class="font-mono text-[10px] uppercase tracking-wide text-brand">design.md</span>
                  </div>
                  <div class="mt-2 space-y-1.5">
                    <div class="h-1.5 w-3/4 rounded bg-slate-200"></div>
                    <div class="h-1.5 w-full rounded bg-slate-200"></div>
                    <div class="h-1.5 w-2/3 rounded bg-slate-200"></div>
                    <div class="h-1.5 w-5/6 rounded bg-slate-100"></div>
                  </div>
                </div>
              </div>
            )}

            {step.demo === 'tests' && (
              <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 bg-slate-50 px-3 py-2 font-mono text-[11px] text-slate-400">vitest run</div>
                <div class="space-y-1 px-4 py-3 font-mono text-[12px] leading-relaxed">
                  <div class="ai-ln text-slate-500">describe('AiWorkflow', () =&gt; &#123;</div>
                  <div class="ai-ln pl-3 text-slate-500">it('renders 6 steps')</div>
                  <div class="ai-ln pl-3 text-slate-500">it('shows Optional badge on step 2')</div>
                  <div class="ai-ln pl-3 text-slate-500">it('connector stops before 06')</div>
                  <div class="ai-ln flex items-center gap-2 pt-1">
                    <span class="rounded bg-red-100 px-1.5 py-0.5 text-[10px] font-bold text-red-600">FAIL</span>
                    <span class="text-slate-400">3 failed · 0 passed</span>
                  </div>
                </div>
              </div>
            )}

            {step.demo === 'terminal' && (
              <div>
                <div class="mb-2 h-1 w-full overflow-hidden rounded-full bg-slate-200">
                  <div class="ai-prog-fill h-full rounded-full bg-brand"></div>
                </div>
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-900 shadow-sm">
                  <div class="flex items-center gap-2 border-b border-white/10 px-3 py-2">
                    <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
                    <span class="whitespace-nowrap font-mono text-[10px] text-white/40">claude code · agent mode</span>
                  </div>
                  <div class="relative h-[104px] overflow-hidden px-4 py-2 [mask-image:linear-gradient(to_bottom,transparent,#000_22%,#000_78%,transparent)]">
                    <div class="ai-term-roll font-mono text-[11px] leading-relaxed text-emerald-300/80 blur-[1.1px]">
                      {Array.from({ length: 16 }).map((_, n) => (
                        <div>+ const step = steps[{n}]; // impl</div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            )}

            {step.demo === 'checks' && (
              <div class="space-y-2.5 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                {checkItems.map((t) => (
                  <div class="ai-ck-row flex items-center gap-2.5">
                    <span class="ai-ck flex h-5 w-5 items-center justify-center rounded-full border-2 border-slate-300">
                      <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6" /></svg>
                    </span>
                    <span class="text-[13px] text-slate-600">{t}</span>
                  </div>
                ))}
              </div>
            )}

            {step.demo === 'git' && (
              <div class="relative rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <svg viewBox="0 0 320 64" class="w-full" fill="none">
                  <line x1="20" y1="32" x2="300" y2="32" stroke="#e2e8f0" stroke-width="3" />
                  <circle cx="20" cy="32" r="6" fill="#94a3b8" />
                  <circle cx="160" cy="32" r="6" fill="#94a3b8" />
                  <circle cx="300" cy="32" r="6" fill="#026766" />
                  <circle class="ai-gitdot" cx="20" cy="32" r="7" fill="#026766" />
                  <text x="20" y="56" font-size="8" fill="#94a3b8" text-anchor="middle" class="font-mono">main</text>
                  <text x="300" y="56" font-size="8" fill="#026766" text-anchor="end" class="font-mono">origin/main</text>
                </svg>
                <div class="ai-confetti pointer-events-none absolute right-8 top-8"></div>
                <div class="font-mono mt-1 pl-4 max-md:pl-2 text-[11px] max-md:text-[10px] text-slate-500">feat(ui): add AI-Workflow timeline section</div>
              </div>
            )}
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Reveal */
  .ai-step { opacity: 0; transform: translateY(18px); transition: opacity .55s ease, transform .55s cubic-bezier(.2,.7,.3,1); }
  .ai-step.is-in { opacity: 1; transform: none; }

  /* Step 1 — typewriter caret (nutzt globales @keyframes caret) */
  .ai-caret { display: inline-block; width: 2px; height: 1.05em; margin-left: 2px; vertical-align: -2px; background: #026766; animation: caret 1s steps(1) infinite; }

  /* Step 2 — split reveal */
  .ai-prompt { opacity: 0; transform: translateX(-6px); transition: opacity .4s ease, transform .4s ease; }
  .ai-prompt.is-in { opacity: 1; transform: none; }
  .ai-card { opacity: 0; transform: scale(.95); transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1); }
  .ai-card.is-in { opacity: 1; transform: none; }

  /* Step 3 — staggered lines */
  .ai-ln { opacity: 0; transform: translateY(6px); transition: opacity .3s ease, transform .3s ease; }
  .ai-ln.is-in { opacity: 1; transform: none; }

  /* Step 4 — progress + terminal roll (ai-term-roll @keyframes in global.css) */
  .ai-prog-fill { width: 0; transition: width 1.6s cubic-bezier(.45,.05,.2,1); }
  .ai-prog-fill.is-in { width: 100%; }
  .ai-term-roll.is-in { animation: ai-term-roll 2.2s linear infinite; }

  /* Step 5 — checkmarks */
  .ai-ck { transition: background-color .25s ease, border-color .25s ease; }
  .ai-ck svg { stroke-dasharray: 18; stroke-dashoffset: 18; transition: stroke-dashoffset .3s ease .05s; }
  .ai-ck.is-done { background: #026766; border-color: #026766; }
  .ai-ck.is-done svg { stroke-dashoffset: 0; }
  .ai-ck-row { opacity: .45; transition: opacity .3s ease; }
  .ai-ck-row.is-done { opacity: 1; }

  /* Step 6 — confetti (ai-confetti @keyframes in global.css) */
  .ai-confetti :global(span) { position: absolute; width: 7px; height: 7px; border-radius: 1px; animation: ai-confetti .8s ease-out forwards; }

  @media (prefers-reduced-motion: reduce) {
    .ai-step, .ai-ln, .ai-prompt, .ai-card { opacity: 1 !important; transform: none !important; transition: none; }
    .ai-prog-fill { width: 100% !important; }
    .ai-caret, .ai-term-roll { animation: none !important; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const typeText = `# 01-feature.md
## Goal
Add AI-Workflow timeline section
## User Story
Given a recruiter
When viewing the portfolio
Then they see a 6-step AI process with animations
## Acceptance Criteria
- All 6 steps visible with title + description
- Step 2 carries Optional badge
- Each step animates once on scroll`;

  function playDemo(step) {
    const type = step.dataset.demo;

    if (type === 'typewriter') {
      const out = step.querySelector('.ai-type');
      if (!out) return;
      if (reduce) { out.textContent = typeText; return; }
      out.textContent = '';
      let k = 0;
      const t = setInterval(() => {
        out.textContent = typeText.slice(0, k++);
        if (k > typeText.length) clearInterval(t);
      }, 14);
    }

    if (type === 'split') {
      const p = step.querySelector('.ai-prompt');
      const c = step.querySelector('.ai-card');
      if (reduce) { p?.classList.add('is-in'); c?.classList.add('is-in'); return; }
      setTimeout(() => p?.classList.add('is-in'), 80);
      setTimeout(() => c?.classList.add('is-in'), 320);
    }

    if (type === 'tests') {
      const lines = step.querySelectorAll('.ai-ln');
      lines.forEach((l, j) => setTimeout(() => l.classList.add('is-in'), reduce ? 0 : j * 90));
    }

    if (type === 'terminal') {
      const fill = step.querySelector('.ai-prog-fill');
      const roll = step.querySelector('.ai-term-roll');
      requestAnimationFrame(() => { fill?.classList.add('is-in'); roll?.classList.add('is-in'); });
    }

    if (type === 'checks') {
      const rows = step.querySelectorAll('.ai-ck-row');
      rows.forEach((r, j) => setTimeout(() => {
        r.classList.add('is-done');
        r.querySelector('.ai-ck')?.classList.add('is-done');
      }, reduce ? 0 : 250 + j * 160));
    }

    if (type === 'git') {
      const dot = step.querySelector('.ai-gitdot');
      const burst = step.querySelector('.ai-confetti');
      if (!dot) return;
      if (reduce) { dot.setAttribute('cx', '300'); return; }
      dot.style.transition = 'none';
      dot.setAttribute('cx', '20');
      requestAnimationFrame(() => {
        dot.style.transition = 'cx 1.4s cubic-bezier(.5,0,.2,1)';
        dot.setAttribute('cx', '300');
      });
      if (burst) {
        const colors = ['#026766', '#d97757', '#1ccdb9', '#f59e0b', '#334155'];
        setTimeout(() => {
          for (let n = 0; n < 14; n++) {
            const d = document.createElement('span');
            d.style.background = colors[n % colors.length];
            const ang = Math.random() * Math.PI * 2;
            const dist = 22 + Math.random() * 30;
            d.style.setProperty('--cx', Math.cos(ang) * dist + 'px');
            d.style.setProperty('--cy', (Math.sin(ang) * dist - 10) + 'px');
            d.style.animationDelay = (Math.random() * 0.06) + 's';
            burst.appendChild(d);
          }
        }, 1350);
      }
    }
  }

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const step = e.target;
      step.classList.add('is-in');
      if (!step.dataset.played) { step.dataset.played = '1'; playDemo(step); }
      io.unobserve(step);
    }
  }, { threshold: 0.2, rootMargin: '0px 0px -12% 0px' });

  document.querySelectorAll('.ai-step').forEach((s) => io.observe(s));
</script>
