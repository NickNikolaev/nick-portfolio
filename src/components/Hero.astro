---
---

<div class="relative overflow-hidden">

  <!-- animated blueprint-grid background -->
  <div class="pointer-events-none absolute inset-0 z-0 [background-image:linear-gradient(rgba(2,103,102,.10)_1px,transparent_1px),linear-gradient(90deg,rgba(2,103,102,.10)_1px,transparent_1px)] [background-size:48px_48px] [mask-image:radial-gradient(ellipse_90%_75%_at_65%_45%,#000_35%,transparent_90%)] animate-grid-drift motion-reduce:animate-none"></div>

<section id="intro" class="relative mx-auto grid min-h-[calc(100vh-4rem)] max-w-6xl grid-cols-1 items-center gap-14 px-6 md:grid-cols-[260px_1fr]">

  <!-- left: datasheet -->
  <aside class="relative z-10 flex flex-row flex-wrap items-center gap-x-8 gap-y-5 border-b border-slate-200 pb-7 md:flex-col md:items-stretch md:gap-6 md:border-b-0 md:border-r md:pb-0 md:pr-8">
    <img class="h-24 w-24 rounded-full object-cover shadow-[0_0_0_1px_#e2e8f0,0_8px_24px_-10px_rgba(2,103,102,.35)]" src="/assets/images/nick.png" alt="Nick Nikolaev" />
    <div class="min-w-[220px] flex-1 divide-y divide-dashed divide-slate-200 md:flex-none">
      <div class="flex items-baseline justify-between gap-4 py-2.5">
        <span class="font-mono text-[10.5px] uppercase tracking-wide text-slate-400">Name</span>
        <span class="text-sm font-semibold text-slate-900">Nick Nikolaev</span>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-2.5">
        <span class="font-mono text-[10.5px] uppercase tracking-wide text-slate-400" data-i18n="sheet.loc">Standort</span>
        <span class="text-sm font-semibold text-brand">Zürich, CH</span>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-2.5">
        <span class="font-mono text-[10.5px] uppercase tracking-wide text-slate-400" data-i18n="sheet.role">Rolle</span>
        <span class="text-sm font-semibold text-slate-900">Gründungsingenieur</span>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-2.5">
        <span class="font-mono text-[10.5px] uppercase tracking-wide text-slate-400" data-i18n="sheet.mode">Modus</span>
        <span class="text-sm font-semibold text-slate-900" data-i18n="sheet.mode.v">Festanstellung</span>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-2.5">
        <span class="font-mono text-[10.5px] uppercase tracking-wide text-slate-400">Status</span>
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-green-600">
          <span class="relative inline-flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full rounded-full border-2 border-green-600 opacity-50 animate-ping motion-reduce:animate-none"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-600"></span>
          </span>
          <span data-i18n="sheet.status.v">Sofort verfügbar</span>
        </span>
      </div>
    </div>
  </aside>

  <!-- right: content -->
  <div class="relative z-[2] flex flex-col gap-6 py-12">
    <span class="font-mono text-xs uppercase tracking-[0.18em] text-slate-400">01 — INTRO</span>

    <h1 class="text-[clamp(2.6rem,5.2vw,4.6rem)] font-extrabold leading-[1.02] tracking-tight text-slate-900">
      <span data-i18n="hero.prefix">KI-unterstützter</span><br>
      <span class="mt-[0.15em] inline-flex items-center rounded-2xl bg-brand/10 px-[0.3em] py-[0.04em] leading-[1.05] text-brand shadow-[inset_0_0_0_1.5px_rgba(2,103,102,.25)]">
        <span class="min-w-[1ch]" id="role"></span>
        <span class="ml-[0.08em] inline-block h-[0.92em] w-[3px] -translate-y-[0.06em] rounded bg-brand animate-caret motion-reduce:animate-none"></span>
      </span>
    </h1>

    <p class="max-w-[54ch] text-lg leading-relaxed text-slate-600 [&_strong]:font-semibold [&_strong]:text-slate-900" data-i18n="hero.sub">Erfahrung im Aufbau von <strong>Enterprise-SaaS-Plattformen</strong>, <strong>Echtzeit-Kollaborationssystemen</strong> und <strong>KI-gestützten Anwendungen</strong>.</p>

    <div class="mt-1.5 flex flex-wrap items-center gap-4">
      <a href="/#experience" class="inline-flex items-center gap-2 rounded-[10px] bg-brand px-6 py-3 font-semibold text-white shadow-[0_8px_20px_-10px_rgba(2,103,102,.6)] transition hover:-translate-y-px hover:bg-brand-hover"><span data-i18n="cta.exp">Meine Erfahrung</span> →</a>
      <a href="mailto:nick_nikolaev@protonmail.com" class="inline-flex items-center gap-2 rounded-[10px] border border-slate-200 bg-white px-6 py-3 font-semibold text-slate-900 transition hover:border-brand hover:text-brand" data-i18n="cta.contact">Kontakt</a>
    </div>

    <span class="mt-2 inline-flex items-center gap-2 font-mono text-xs text-slate-400"><span data-i18n="scroll">Scrollen zum Entdecken</span> <span class="inline-block animate-bob motion-reduce:animate-none">↓</span></span>
  </div>
</section>

</div>

<!-- Hero typing effect -->
<script>
  const roleEl = document.getElementById('role');
  if (roleEl) {
    const ROLES = ['Gründungsingenieur', 'Softwareingenieur', 'Full Stack Entwickler'];
    let r = 0, c = 0, del = false;
    (function tick() {
      const w = ROLES[r];
      c += del ? -1 : 1;
      roleEl.textContent = w.slice(0, c);
      if (!del && c === w.length) { del = true; return setTimeout(tick, 1600); }
      if (del && c === 0) { del = false; r = (r + 1) % ROLES.length; return setTimeout(tick, 280); }
      setTimeout(tick, del ? 40 : 85);
    })();
  }
</script>
