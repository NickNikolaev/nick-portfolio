---
import type { Lang, Translation } from '../i18n/translations';

interface Props {
  lang: Lang;
  translation: Translation;
}

const { lang, translation } = Astro.props;
const t = translation.nav;

const links = [
  { href: `/${lang}#intro`,       label: t.intro },
  { href: `/${lang}#experience`,  label: t.experience },
  { href: `/${lang}#work`,        label: t.work },
  { href: `/${lang}#impact`,      label: t.impact },
  { href: `/${lang}#ai-workflow`, label: t.ai_workflow },
  { href: `/${lang}#faq`,         label: t.faq },
];
---

<header class="sticky top-0 z-30 border-b border-slate-100 bg-white/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6">
    <!-- Language toggle — always DE|EN, active language highlighted -->
    <span class="inline-flex overflow-hidden rounded-lg border border-slate-200" id="lang-toggle">
      <button type="button" data-lang="de" class="js-lang px-3 py-1.5 font-mono text-xs font-bold tracking-wide text-slate-500 transition data-[active]:bg-brand data-[active]:text-white">DE</button>
      <button type="button" data-lang="en" class="js-lang px-3 py-1.5 font-mono text-xs font-bold tracking-wide text-slate-500 transition data-[active]:bg-brand data-[active]:text-white">EN</button>
    </span>

    <!-- Desktop nav -->
    <div class="js-nav-desktop-menu max-md:hidden flex items-center gap-6 text-sm font-medium text-slate-600">
      { links.map((l) => (
          <a
              href={l.href}
              class="transition hover:text-brand"
          >{l.label}</a>
      ))}
    </div>

    <!-- Hamburger (mobile-only) -->
    <button class="md:hidden flex flex-col gap-1.5 p-2 js-hamburger" aria-label={t.menu_open} aria-expanded="false">
      <span class="block h-0.5 w-5 bg-slate-700 transition-all js-bar-1"></span>
      <span class="block h-0.5 w-5 bg-slate-700 transition-all js-bar-2"></span>
      <span class="block h-0.5 w-5 bg-slate-700 transition-all js-bar-3"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div class="js-mobile-menu hidden md:hidden border-t border-slate-100 bg-white px-6 pb-4">
    {links.map((l) => (
        <a
            href={l.href}
            class="block py-2.5 text-sm font-medium text-slate-700 transition hover:text-brand"
        >{l.label}</a>
    ))}
  </div>
</header>

<script>
  // Hamburger toggle (mobile)
  const hamburger = document.querySelector('.js-hamburger') as HTMLButtonElement;
  const mobile_menu = document.querySelector('.js-mobile-menu') as HTMLElement;
  const bar_1 = document.querySelector('.js-bar-1') as HTMLElement;
  const bar_2 = document.querySelector('.js-bar-2') as HTMLElement;
  const bar_3 = document.querySelector('.js-bar-3') as HTMLElement;

  hamburger.addEventListener('click', () => {
    const open = mobile_menu.classList.toggle('hidden') === false;
    hamburger.setAttribute('aria-expanded', String(open));
    bar_1.classList.toggle('translate-y-2', open);
    bar_1.classList.toggle('rotate-45', open);
    bar_2.classList.toggle('opacity-0', open);
    bar_3.classList.toggle('-translate-y-2', open);
    bar_3.classList.toggle('-rotate-45', open);
  });

  // We close the mobile nav menu when a nav link is clicked for better UX
  mobile_menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if ( mobile_menu.classList.contains('hidden') ) return;

      mobile_menu.classList.add('hidden');
      hamburger.setAttribute('aria-expanded', 'false');
      bar_1.classList.remove('translate-y-2', 'rotate-45');
      bar_2.classList.remove('opacity-0');
      bar_3.classList.remove('-translate-y-2', '-rotate-45');
    });
  });

  // Language toggle
  const current_lang = location.pathname.startsWith('/en') ? 'en' : 'de';
  const lang_toggle = document.getElementById('lang-toggle') as HTMLElement;
  const btn_de = lang_toggle.querySelector('[data-lang="de"]') as HTMLButtonElement;
  const btn_en = lang_toggle.querySelector('[data-lang="en"]') as HTMLButtonElement;

  // Mark the active language button
  (current_lang === 'de' ? btn_de : btn_en).setAttribute('data-active', '');

  // Navigate on click — ignore clicks on the already-active language
  lang_toggle.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.js-lang') as HTMLButtonElement | null;
    if (!btn || btn.dataset.lang === current_lang) return;
    location.href = `/${btn.dataset.lang}`;
  });
</script>
