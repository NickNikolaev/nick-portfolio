---
const pathname = Astro.url.pathname;
const is_nav_link_active = (href: string) => {
  if ( href === '/' ) return pathname === '/'; // Without this, "/" would match every route.
  return pathname === href        // Exact match, e.g. /feedback
      || pathname.startsWith(href + '/'); // Marks parent active when on a child route, e.g. /experience/alignment → /experience
};
---

<header class="sticky top-0 z-10 border-b border-slate-100 bg-white/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <span class="text-base font-semibold tracking-tight text-slate-900">
      Nick Nikolaev
    </span>

    <!-- Nav visible only on desktop -->
    <div class="js-nav-desktop-menu max-md:hidden flex items-center self-stretch gap-6 text-sm font-medium text-slate-600">
      <a href="/" class:list={["transition hover:text-brand", is_nav_link_active('/') && "text-brand"]}>
        Home
      </a>

      <!-- We need full height to extend the hover zone to bridge the gap between the button and the dropdown menu -->
      <div class="js-nav-desktop-experience-dropdown relative h-full flex">
        <button
          class:list={["flex items-center gap-1 transition hover:text-brand cursor-default", is_nav_link_active('/experience') && "text-brand"]}
          aria-haspopup="true"
          aria-expanded="false"
        >
          Erfahrung
          <svg class="js-nav-desktop-experience-dropdown-chevron w-3.5 h-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="js-nav-desktop-experience-dropdown-menu absolute -left-2 top-full hidden min-w-[180px] rounded-lg border border-slate-100 bg-white shadow-md py-1">
          <a href="/experience/alignment" class:list={["block px-4 py-2 text-sm transition hover:bg-slate-50 hover:text-brand", is_nav_link_active('/experience/alignment') ? "text-brand" : "text-slate-700"]}>Alignment</a>
        </div>
      </div>

      <a href="/feedback" class:list={["transition hover:text-brand", is_nav_link_active('/feedback') && "text-brand"]}>
        Rückmeldung
      </a>
    </div>

    <!-- Hamburger (mobile-only) -->
    <button class="md:hidden flex flex-col gap-1.5 p-2 js-hamburger" aria-label="Menü öffnen" aria-expanded="false">
      <span class="block h-0.5 w-5 bg-slate-700 transition-all js-bar-1"></span>
      <span class="block h-0.5 w-5 bg-slate-700 transition-all js-bar-2"></span>
      <span class="block h-0.5 w-5 bg-slate-700 transition-all js-bar-3"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div class="js-mobile-menu hidden md:hidden border-t border-slate-100 bg-white px-6 pb-4">
    <a href="/" class:list={["block py-2.5 text-sm font-medium transition hover:text-brand", is_nav_link_active('/') ? "text-brand" : "text-slate-700"]}>Home</a>

    <div>
      <button class:list={["js-mobile-dropdown flex w-full items-center justify-between py-2.5 text-sm font-medium transition hover:text-brand", is_nav_link_active('/experience') ? "text-brand" : "text-slate-700"]}>
        Erfahrung
        <svg class="w-3.5 h-3.5 transition-transform js-mobile-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="hidden pl-4 js-mobile-dropdown-menu">
        <a href="/experience/alignment" class:list={["block py-2 text-sm transition hover:text-brand", is_nav_link_active('/experience/alignment') ? "text-brand" : "text-slate-600"]}>Alignment.io</a>
      </div>
    </div>

    <a href="/feedback" class:list={["block py-2.5 text-sm font-medium transition hover:text-brand", is_nav_link_active('/feedback') ? "text-brand" : "text-slate-700"]}>Rückmeldung</a>
  </div>
</header>

<script>
  const nav_desktop_menu = document.querySelector('.js-nav-desktop-menu') as HTMLElement;
  if ( nav_desktop_menu.checkVisibility() ) {
    const dropdown = document.querySelector('.js-nav-desktop-experience-dropdown') as HTMLElement;
    const dropdown_menu = document.querySelector('.js-nav-desktop-experience-dropdown-menu') as HTMLElement;
    const chevron = document.querySelector('.js-nav-desktop-experience-dropdown-chevron') as SVGElement;
    const drop_btn = dropdown.querySelector('button');

    dropdown.addEventListener('mouseenter', () => {
      dropdown_menu.classList.remove('hidden');
      chevron.classList.add('rotate-180');
      drop_btn.setAttribute('aria-expanded', 'true');
    });
    dropdown.addEventListener('mouseleave', () => {
      dropdown_menu.classList.add('hidden');
      chevron.classList.remove('rotate-180');
      drop_btn.setAttribute('aria-expanded', 'false');
    });

  } else {
    const hamburger = document.querySelector('.js-hamburger') as HTMLButtonElement;
    const mobile_menu = document.querySelector('.js-mobile-menu') as HTMLElement;
    const bar_1 = document.querySelector('.js-bar-1') as HTMLElement;
    const bar_2 = document.querySelector('.js-bar-2') as HTMLElement;
    const bar_3 = document.querySelector('.js-bar-3') as HTMLElement;

    hamburger.addEventListener('click', () => {
      const open = mobile_menu.classList.toggle('hidden') === false;
      hamburger.setAttribute('aria-expanded', String(open));
      bar_1.classList.toggle('translate-y-2', open);
      bar_1.classList.toggle('rotate-45', open);
      bar_2.classList.toggle('opacity-0', open);
      bar_3.classList.toggle('-translate-y-2', open);
      bar_3.classList.toggle('-rotate-45', open);
    });

    const mobile_drop_btn = document.querySelector('.js-mobile-dropdown') as HTMLElement;
    const mobile_drop_menu = document.querySelector('.js-mobile-dropdown-menu') as HTMLElement;
    const mobile_chevron = document.querySelector('.js-mobile-chevron') as SVGElement;

    mobile_drop_btn.addEventListener('click', () => {
      const open = mobile_drop_menu.classList.toggle('hidden') === false;
      mobile_chevron.classList.toggle('rotate-180', open);
    });
  }
</script>