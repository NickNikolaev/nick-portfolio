---
import Base from '../../layouts/Base.astro';
---

<Base title="Alignment.io — Nick Nikolaev" description="Engineering Lead bei Alignment.io — New York">
  <section class="mx-auto max-w-6xl px-6 py-20">

    <div class="flex items-center gap-4">
      <img src="/assets/logos/alignment.png" alt="Alignment.io" class="h-10 w-auto" />
      <span class="text-sm font-medium text-slate-500">Alignment.io</span>
    </div>

    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">
      Engineering Lead
    </h1>

    <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-500">
      <span>New York, USA</span>
      <span>2022 – 2024</span>
      <span>Arbeitssprache: Englisch</span>
    </div>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-600">
      Alignment.io ist eine B2B-SaaS-Plattform, die Vertriebsteams dabei hilft,
      Kundengespräche zu analysieren und Deals schneller abzuschliessen.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-xs font-medium uppercase tracking-widest text-slate-400">Team</p>
        <p class="mt-2 text-sm text-slate-700">Jim Benton · Gidon Wise</p>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-xs font-medium uppercase tracking-widest text-slate-400">Tech Stack</p>
        <p class="mt-2 text-sm text-slate-700">JavaScript</p>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-xs font-medium uppercase tracking-widest text-slate-400">Teamgrösse</p>
        <p class="mt-2 text-sm text-slate-700">5 Personen aufgebaut</p>
      </div>
    </div>

  </section>
</Base>