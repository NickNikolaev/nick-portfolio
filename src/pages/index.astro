---
import Base from '../layouts/Base.astro';
---

<Base>
  <section class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-6xl flex-col justify-center px-6 py-20">
    <div class="flex items-center gap-4">
      <img
        src="/assets/images/nick.png"
        alt="Nick Nikolaev"
        class="h-20 w-20 rounded-full object-cover"
      />
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Nick Nikolaev</h1>
        <p class="mt-1 text-sm text-slate-500">Tech Lead · Senior Engineer · Full Stack</p>
      </div>
    </div>

    <p class="mt-8 text-sm font-medium uppercase tracking-[0.2em] text-brand">
      Offen für Festanstellung · Vor Ort · Deutschsprachige Schweiz
    </p>

    <p class="mt-2 text-sm text-slate-500">
      <a href="/assets/files/ielts.pdf" target="_blank" rel="noopener noreferrer" class="hover:text-brand transition-colors">Englisch C1 ↗</a> · Deutsch B2
    </p>

    <h2 class="mt-4 max-w-4xl text-5xl font-extrabold leading-[1.05] tracking-tight text-slate-900 sm:text-6xl md:text-7xl">
      AI-powered Tech-Leiter für
      <span class="text-brand">Early-Stage-Startups</span>
    </h2>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl">
      Ich helfe Schweizer Web-Startups ihr Produkt schnell zur Marktreife zu bringen — mit
      Engineering-Leadership, Produktstrategie und AI-Integration.
    </p>

    <p class="mt-12 text-sm text-slate-400">Scroll to explore ↓</p>

    <div class="mt-12">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
        Vertraut von Teams bei
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-x-10 gap-y-6">
        <img
          src="/assets/logos/Logo-Allianz.png"
          alt="Allianz"
          class="h-7 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
        />
        <img
          src="/assets/logos/defensestorm-logo.png"
          alt="DefenseStorm"
          class="h-7 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
        />
        <img
          src="/assets/logos/redpoint.png"
          alt="Redpoint"
          class="h-7 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
      Erfahrung
    </h2>

    <div class="relative mt-12">
      <div class="absolute left-3 top-0 bottom-0 border-l-2 border-slate-200"></div>

      <div class="space-y-10 sm:space-y-14">

        <div class="relative flex gap-6 sm:gap-8">
          <div class="relative z-10 shrink-0 w-6 flex justify-center pt-6">
            <div class="w-3 h-3 rounded-full bg-brand ring-2 ring-white shadow-sm"></div>
          </div>
          <article class="flex-1 max-w-lg rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow duration-200">
            <img
              src="/assets/images/alignment.png"
              alt="Alignment.io Screenshot"
              class="w-full h-48 sm:h-56 object-cover rounded-t-2xl"
            />
            <hr class="border-slate-200" />
            <div class="p-5 sm:p-6 space-y-3">
              <div class="flex items-center gap-3">
                <img src="/assets/logos/alignment.png" alt="Alignment.io Logo" class="h-6 w-auto" />
                <a
                  href="https://alignment.io"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-slate-900 hover:text-brand transition-colors"
                >Alignment.io</a>
              </div>
              <p class="text-sm text-slate-500">KI-SaaS Plattform für Unternehmensstrategie & OKRs</p>
              <p class="font-medium text-slate-800">Technischer Leiter</p>
              <p class="text-sm text-slate-500">2022 – 2026 · 3 Jahre 3 Monate</p>
              <p class="text-sm text-slate-500">Remote · StartX, Kalifornien</p>
              <a
                href="/experience/alignment"
                class="inline-flex items-center gap-1 text-sm font-semibold text-brand hover:text-brand-hover transition-colors"
              >
                Lies meine Auswirkungen →
              </a>
            </div>
          </article>
        </div>

        <div class="relative flex gap-6 sm:gap-8">
          <div class="relative z-10 shrink-0 w-6 flex justify-center pt-6">
            <div class="w-3 h-3 rounded-full bg-brand ring-2 ring-white shadow-sm"></div>
          </div>
          <article class="flex-1 max-w-lg rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow duration-200">
            <img
                src="/assets/images/thedatagroup.png"
                alt="TheDataGroup.cloud Screenshot"
                class="w-full h-48 sm:h-56 object-cover rounded-t-2xl"
            />
            <hr class="border-slate-200" />
            <div class="p-5 sm:p-6 space-y-3">
              <div class="flex items-center gap-3">
                <img src="/assets/logos/thedatagroup.png" alt="TheDataGroup.cloud Logo" class="h-6 w-auto" />
                <a
                    href="https://thedatagroup.cloud"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-slate-900 hover:text-brand transition-colors"
                >TheDataGroup.cloud</a>
              </div>
              <p class="text-sm text-slate-500">US-basiertes B2B-Datenplattform-Startup, das Unternehmen hilft, Daten systemübergreifend zu vereinheitlichen und zu verwalten</p>
              <p class="font-medium text-slate-800">Back-End Entwickler</p>
              <p class="text-sm text-slate-500">2022 · 7 Monate</p>
              <p class="text-sm text-slate-500">Remote · Alabama, Vereinigte Staaten von Amerika</p>
              <a
                  href="/experience/thedatagroup"
                  class="inline-flex items-center gap-1 text-sm font-semibold text-brand hover:text-brand-hover transition-colors"
              >
                Lies meine Auswirkungen →
              </a>
            </div>
          </article>
        </div>

        <div class="relative flex gap-6 sm:gap-8">
          <div class="relative z-10 shrink-0 w-6 flex justify-center pt-6">
            <div class="w-3 h-3 rounded-full bg-brand ring-2 ring-white shadow-sm"></div>
          </div>
          <article class="flex-1 max-w-lg rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow duration-200">
            <img
                src="/assets/images/hazemag.png"
                alt="Hazemag.com Screenshot"
                class="w-full h-48 sm:h-56 object-cover rounded-t-2xl"
            />
            <hr class="border-slate-200" />
            <div class="p-5 sm:p-6 space-y-3">
              <div class="flex items-center gap-3">
                <img src="/assets/logos/hazemag.jpg" alt="Hazemag.com Logo" class="h-6 w-auto" />
                <a
                    href="https://hazemag.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-slate-900 hover:text-brand transition-colors"
                >Hazemag.com</a>
              </div>
              <p class="text-sm text-slate-500">Industrieunternehmen (gegründet 1946) für Bergbau und Zement mit globaler Kundschaft.</p>
              <p class="font-medium text-slate-800">Full-Stack Entwickler</p>
              <p class="text-sm text-slate-500">2021 - 2022 · 7 Monate</p>
              <p class="text-sm text-slate-500">Vor Ort · Dülmen, Deutschland</p>
              <a
                  href="/experience/hazemag"
                  class="inline-flex items-center gap-1 text-sm font-semibold text-brand hover:text-brand-hover transition-colors"
              >
                Lies meine Auswirkungen →
              </a>
            </div>
          </article>
        </div>

        <div class="relative flex gap-6 sm:gap-8">
          <div class="relative z-10 shrink-0 w-6 flex justify-center pt-6">
            <div class="w-3 h-3 rounded-full bg-brand ring-2 ring-white shadow-sm"></div>
          </div>
          <article class="flex-1 max-w-lg rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow duration-200">
            <img
                src="/assets/images/nanv.jpg"
                alt="Naval Akademie Nikola Vaptsarov Screenshot"
                class="w-full h-48 sm:h-56 object-cover rounded-t-2xl"
            />
            <hr class="border-slate-200" />
            <div class="p-5 sm:p-6 space-y-3">
              <div class="flex items-center gap-3">
                <img src="/assets/logos/nvna.png" alt="NVNA Logo" class="h-6 w-auto" />
                <a
                  href="https://www.naval-acad.bg/en"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-slate-900 hover:text-brand transition-colors"
                >Naval Akademie Nikola Vaptsarov</a>
              </div>
              <p class="font-medium text-slate-800">B.Sc. Cybersecurity</p>
              <p class="text-sm text-slate-500">2020 – 2022 · 2 Jahre</p>
              <p class="text-sm text-slate-500">Bulgarien</p>
              <p class="text-sm text-slate-500">Note · 5,0 / 6,0</p>
              <a
                href="/assets/files/nanv-transcript-de.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-sm font-semibold text-brand hover:underline"
              >
                Transcript ansehen ↗
              </a>
            </div>
          </article>
        </div>

      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
      Referenzen
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-sm">
        <div class="flex items-center gap-4">
          <img
            src="/assets/images/jim.png"
            alt="Jim Benton"
            class="h-20 w-20 shrink-0 rounded-full object-cover"
          />
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Jim Benton</h3>
            <p class="text-sm text-slate-500">Managing Partner, Alignment.io</p>
          </div>
        </div>

        <blockquote class="mt-6 border-l-2 border-brand pl-4 italic leading-relaxed text-slate-700">
          „Nick zeigte außergewöhnliche Problemlösungskompetenz."
        </blockquote>

        <div class="mt-4 space-y-1.5 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <img src="/assets/logos/chorus.svg" alt="Chorus.ai" class="h-4 w-auto" />
            <span>Chorus.ai · Ex-CEO · Exit: $575M</span>
          </div>
          <div class="flex items-center gap-2">
            <img src="/assets/logos/apollo.png" alt="Apollo.io" class="h-4 w-auto" />
            <span>Apollo.io · Ex-CEO · Unicorn: $1.6B</span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <a
            href="https://linkedin.com/in/benton"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-medium text-slate-600 transition hover:text-brand"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.852 3.37-1.852 3.601 0 4.267 2.37 4.267 5.455v6.288zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
            LinkedIn
          </a>
          <a
            href="mailto:jlbenton@gmail.com"
            class="inline-flex items-center gap-1.5 font-medium text-slate-600 transition hover:text-brand"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            Email
          </a>
        </div>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-sm">
        <div class="flex items-center gap-4">
          <img
            src="/assets/images/gidon.jpg"
            alt="Gidon Wise"
            class="h-20 w-20 shrink-0 rounded-full object-cover"
          />
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Gidon Wise</h3>
            <p class="text-sm text-slate-500">CTO, Alignment.io</p>
          </div>
        </div>

        <blockquote class="mt-6 border-l-2 border-brand pl-4 italic leading-relaxed text-slate-700">
          „Ich bin erreichbar und spreche gerne persönlich über Nick."
        </blockquote>

        <div class="mt-4 space-y-1.5 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <img src="/assets/logos/distrokid.svg" alt="DistroKid" class="h-4 w-auto max-w-15" />
            <span>DistroKid · Founding CTO · Unicorn: $1.3B</span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <a
            href="tel:+16465524228"
            class="inline-flex items-center gap-1.5 font-medium text-slate-600 transition hover:text-brand"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            +1 (646) 552-4228
          </a>
          <a
            href="mailto:gidon@gidon.com"
            class="inline-flex items-center gap-1.5 font-medium text-slate-600 transition hover:text-brand"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            Email
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
      FAQ
    </h2>

    <div class="mt-12 divide-y divide-slate-200 border-t border-b border-slate-200">
      <div>
        <button
          type="button"
          aria-expanded="false"
          class="js-faq-trigger group peer flex w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-slate-900 transition hover:text-brand"
        >
          <span>Wann kannst du anfangen?</span>
          <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="grid grid-rows-[0fr] peer-aria-expanded:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out">
          <div class="overflow-hidden">
            <p class="pb-5 text-sm leading-relaxed text-slate-600">Sofort verfügbar.</p>
          </div>
        </div>
      </div>

      <div>
        <button
          type="button"
          aria-expanded="false"
          class="js-faq-trigger group peer flex w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-slate-900 transition hover:text-brand"
        >
          <span>Remote oder vor Ort?</span>
          <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="grid grid-rows-[0fr] peer-aria-expanded:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out">
          <div class="overflow-hidden">
            <p class="pb-5 text-sm leading-relaxed text-slate-600">Vor Ort — deutschsprachige Schweiz. Umzug möglich.</p>
          </div>
        </div>
      </div>

      <div>
        <button
          type="button"
          aria-expanded="false"
          class="js-faq-trigger group peer flex w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-slate-900 transition hover:text-brand"
        >
          <span>Festanstellung oder Freelance?</span>
          <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="grid grid-rows-[0fr] peer-aria-expanded:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out">
          <div class="overflow-hidden">
            <p class="pb-5 text-sm leading-relaxed text-slate-600">Nur Festanstellung.</p>
          </div>
        </div>
      </div>

      <div>
        <button
          type="button"
          aria-expanded="false"
          class="js-faq-trigger group peer flex w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-slate-900 transition hover:text-brand"
        >
          <span>Arbeitsberechtigung in der Schweiz?</span>
          <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="grid grid-rows-[0fr] peer-aria-expanded:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out">
          <div class="overflow-hidden">
            <p class="pb-5 text-sm leading-relaxed text-slate-600">EU-Pass — vollständig arbeitsberechtigt in der Schweiz. Kein Sponsoring nötig.</p>
          </div>
        </div>
      </div>

      <div>
        <button
          type="button"
          aria-expanded="false"
          class="js-faq-trigger group peer flex w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-slate-900 transition hover:text-brand"
        >
          <span>Benutzt du KI-gestützte Tools beim Entwickeln?</span>
          <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="grid grid-rows-[0fr] peer-aria-expanded:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out">
          <div class="overflow-hidden">
            <p class="pb-5 text-sm leading-relaxed text-slate-600">Ja — ich arbeite mit Cursor und Claude Code für schnellere Entwicklung.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32">
    <div class="max-w-2xl mx-auto px-6">
      <div class="bg-brand rounded-lg p-10 md:p-12 text-center text-white">
        <p class="text-xs uppercase tracking-[0.2em] mb-6">
          Mission
        </p>
        <p class="text-2xl md:text-3xl leading-snug">
          Hilf Schweizer Early-Stage-Startups dabei, meine Eignung als Tech-Leiter einzuschätzen, durch den Aufbau eines Portfolios, das künftig den Weg eines Startups von Pre-PMF bis Post-PMF dokumentieren wird.
        </p>
      </div>
    </div>
  </section>
</Base>