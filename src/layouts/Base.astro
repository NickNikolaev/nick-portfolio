---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Analytics } from '@vercel/analytics/astro';
import '../styles/global.css';
import type { Lang, Translation } from '../i18n/translations';

interface Props {
  lang: Lang;
  translation: Translation;
}

const { lang, translation } = Astro.props;
const { title, description } = translation.meta;
---

<!doctype html>
<!-- This scrolling class makes sure that clicking on the navigation links scrolls smoothly to the given section -->
<html lang={lang} class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans bg-white text-slate-900 antialiased">
    <Nav lang={lang} translation={translation} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} translation={translation} />
    <Analytics />
  </body>
</html>