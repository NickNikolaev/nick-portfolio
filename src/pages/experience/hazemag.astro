---
import Base from '../../layouts/Base.astro';
---

<Base title="Hazemag — Nick Nikolaev" description="Full-Stack Entwickler bei Hazemag — Dülmen, Deutschland">
  <section class="mx-auto max-w-6xl px-6 py-20">

    <div class="flex items-center gap-4">
      <img src="/assets/logos/hazemag.jpg" alt="Hazemag" class="h-10 w-auto" />
      <span class="text-sm font-medium text-slate-500">Hazemag</span>
    </div>

    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">
      Full-Stack Entwickler
    </h1>

    <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-500">
      <span>Dülmen, Deutschland</span>
      <span>2021 · 7 Monate</span>
      <span>Arbeitssprache: Englisch</span>
    </div>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-600">
      Hazemag & EPR GmbH ist ein weltweit führender Maschinenbauer mit Sitz in Dülmen, spezialisiert auf Zerkleinerungs- und Aufbereitungsanlagen für Bergbau, Zement und Recycling.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-xs font-medium uppercase tracking-widest text-slate-400">Team</p>
        <p class="mt-2 text-sm text-slate-700">Wolfgang · Anton</p>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-xs font-medium uppercase tracking-widest text-slate-400">Tech Stack</p>
        <p class="mt-2 text-sm text-slate-700">JavaScript</p>
      </div>
    </div>

  </section>
</Base>